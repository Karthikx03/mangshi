{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blind-box",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Same anon/publishable Supabase key already committed in .env (not secret —
  // RLS is what protects the data, not hiding this key). The server-side code
  // (db.server.ts, system.functions.ts, etc.) reads these via process.env at
  // runtime, so the deployed Worker needs them here, not just in .env, which
  // only applies to local `vite dev`.
  "vars": {
    "SUPABASE_URL": "https://tkvbeomlrgsqhtwlzten.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_9BVqD9K_TC26KIJ04RCvIA_PrBKXuGF"
  },
}
