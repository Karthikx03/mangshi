# Copy to .env and adjust.
# Port for the API. (Hosting platforms that set PORT are also honored.)
API_PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/mangshi
# Comma-separated list of allowed browser origins (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173
# Secret for the read-only admin endpoint GET /api/join (send as the x-admin-key header).
ADMIN_KEY=change-me
